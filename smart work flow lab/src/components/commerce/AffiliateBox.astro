---
import { Button, Text } from '@/components/ui';
import { AFFILIATE_DISCLOSURE } from '@/config/affiliate';
import { cn } from '@/lib/cn';

interface Props {
  /** e.g. "We recommend" — shown as a small kicker above the name. */
  kicker?: string;
  name: string;
  description?: string;
  price?: string;
  ctaLabel?: string;
  ctaHref: string;
  class?: string;
}

const {
  kicker = 'We recommend',
  name,
  description,
  price,
  ctaLabel = 'Check price',
  ctaHref,
  class: className,
} = Astro.props;
---

<div
  class={cn(
    'not-prose my-8 flex flex-col gap-4 rounded-(--radius-lg) border border-(--color-border) bg-(--color-surface) p-5 sm:flex-row sm:items-center sm:justify-between',
    className,
  )}
>
  <div>
    <Text size="xs" tone="muted" class="font-medium tracking-wide uppercase">{kicker}</Text>
    <p class="mt-1 text-lg font-semibold text-(--color-text)">{name}</p>
    {
      description && (
        <Text size="sm" tone="muted" class="mt-1">
          {description}
        </Text>
      )
    }
    <Text size="xs" tone="muted" class="mt-3">{AFFILIATE_DISCLOSURE}</Text>
  </div>

  <div class="flex shrink-0 items-center gap-3">
    {price && <Text class="font-semibold text-(--color-text)">{price}</Text>}
    <Button href={ctaHref} rel="sponsored noopener" target="_blank">
      {ctaLabel}
    </Button>
  </div>
</div>
