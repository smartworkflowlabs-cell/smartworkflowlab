---
import { Container } from '@/components/ui';

interface Props {
  counts: {
    directory: number;
    compare: number;
    prompts: number;
    workflows: number;
    tools: number;
    glossary: number;
  };
}

const { counts } = Astro.props;

const sections = [
  {
    href: '/directory',
    name: 'AI Directory',
    desc: 'Honest reviews, pricing, and alternatives for the tools worth knowing.',
    count: `${counts.directory} tools`,
    icon: 'M4 6h16M4 12h16M4 18h10',
    featured: true,
  },
  {
    href: '/compare',
    name: 'Comparisons',
    desc: 'Head-to-head breakdowns with a clear verdict — no fence-sitting.',
    count: `${counts.compare} matchups`,
    icon: 'M8 3v18M16 3v18M3 8h5M16 8h5M3 16h5M16 16h5',
  },
  {
    href: '/prompts',
    name: 'Prompt Library',
    desc: 'Copy-paste prompts that actually work, sorted by the job you need done.',
    count: `${counts.prompts} prompts`,
    icon: 'M4 7l4 5-4 5M12 17h8',
  },
  {
    href: '/workflows',
    name: 'Workflow Recipes',
    desc: 'Step-by-step automations you can set up in an afternoon.',
    count: `${counts.workflows} recipes`,
    icon: 'M4 4v5h5M20 20v-5h-5M4.6 9a8 8 0 0113.4-4.5M19.4 15a8 8 0 01-13.4 4.5',
  },
  {
    href: '/tools',
    name: 'Free Tools',
    desc: 'Calculators and finders that answer real questions with real numbers.',
    count: `${counts.tools} calculators`,
    icon: 'M9 7h6m-6 4h6m-6 4h4M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z',
  },
  {
    href: '/glossary',
    name: 'Glossary',
    desc: 'Plain-English definitions for the jargon you keep running into.',
    count: `${counts.glossary} terms`,
    icon: 'M4 19.5A2.5 2.5 0 016.5 17H20M4 19.5A2.5 2.5 0 006.5 22H20V2H6.5A2.5 2.5 0 004 4.5v15z',
  },
];
---

<section class="relative overflow-hidden border-b border-(--color-border) py-20 lg:py-28">
  <Container size="lg">
    <div class="max-w-2xl" data-reveal>
      <p class="font-mono text-xs font-medium tracking-[0.18em] text-(--color-link) uppercase">
        Everything in one place
      </p>
      <h2
        class="font-display mt-4 text-3xl font-semibold text-balance text-(--color-text) sm:text-4xl lg:text-5xl"
      >
        A whole lab for getting AI to work.
      </h2>
      <p class="mt-5 text-lg text-(--color-text-muted)">
        Six ways in, all built on the same promise: real testing, honest verdicts, and no filler.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {
        sections.map((section) => (
          <a
            href={section.href}
            data-reveal
            data-tilt="4"
            class:list={[
              'fx-card fx-glow group relative block overflow-hidden rounded-(--radius-xl) border border-(--color-border) bg-(--color-surface) p-6',
              section.featured && 'sm:col-span-2 lg:col-span-1 lg:row-span-1',
            ]}
          >
            <div class="flex items-start justify-between">
              <span class="flex h-11 w-11 items-center justify-center rounded-(--radius-md) bg-(--color-primary-50) text-(--color-link) transition-transform duration-300 group-hover:scale-110">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d={section.icon}
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <span class="font-mono text-[11px] tracking-wide text-(--color-text-muted) uppercase">
                {section.count}
              </span>
            </div>

            <h3 class="font-display mt-5 text-xl font-semibold text-(--color-text) group-hover:text-(--color-primary-700)">
              {section.name}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-(--color-text-muted)">{section.desc}</p>

            <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-(--color-link)">
              Explore
              <svg
                class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1"
                viewBox="0 0 12 12"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M2 6h8m0 0L6.5 2.5M10 6L6.5 9.5"
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </Container>
</section>
