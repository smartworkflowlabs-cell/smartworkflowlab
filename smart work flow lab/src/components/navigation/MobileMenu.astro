---
import { primaryNav } from '@/config/navigation';
import ThemeToggle from './ThemeToggle.astro';
---

<dialog
  id="mobile-menu"
  aria-label="Site menu"
  class="m-0 ml-auto h-dvh max-h-none w-full max-w-xs bg-(--color-surface) p-0 text-(--color-text) backdrop:bg-black/50"
  data-mobile-menu
>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between border-b border-(--color-border) p-4">
      <span class="font-display text-lg font-semibold">Menu</span>
      <button
        type="button"
        class="rounded-(--radius-md) p-2 text-(--color-text-muted) hover:bg-(--color-bg-subtle)"
        data-mobile-menu-close
        aria-label="Close menu"
      >
        <svg class="h-5 w-5" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path
            d="M2.5 2.5L9.5 9.5M9.5 2.5L2.5 9.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <nav aria-label="Primary" class="flex-1 overflow-y-auto p-4">
      <ul class="flex flex-col gap-1">
        {
          primaryNav.map((item) =>
            item.megaMenu ? (
              <li>
                <details class="group">
                  <summary class="flex cursor-pointer list-none items-center justify-between rounded-(--radius-md) px-3 py-2 text-sm font-medium text-(--color-text) hover:bg-(--color-bg-subtle) [&::-webkit-details-marker]:hidden">
                    {item.label}
                    <svg
                      class="h-3 w-3 text-(--color-text-muted) transition-transform group-open:rotate-180"
                      viewBox="0 0 12 12"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M3 4.5L6 7.5L9 4.5"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </summary>
                  <ul class="mt-1 mb-2 ml-3 flex flex-col gap-1 border-l border-(--color-border) pl-3">
                    {item.megaMenu
                      .flatMap((col) => col.links)
                      .map((link) => (
                        <li>
                          <a
                            href={link.href}
                            class="block rounded-(--radius-md) px-3 py-2 text-sm text-(--color-text-muted) hover:bg-(--color-bg-subtle) hover:text-(--color-text)"
                          >
                            {link.label}
                          </a>
                        </li>
                      ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class="block rounded-(--radius-md) px-3 py-2 text-sm font-medium text-(--color-text) hover:bg-(--color-bg-subtle)"
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="flex items-center justify-between border-t border-(--color-border) p-4">
      <span class="text-sm text-(--color-text-muted)">Theme</span>
      <ThemeToggle />
    </div>
  </div>
</dialog>

<script>
  document.addEventListener('click', (e) => {
    const target = e.target as Element;

    const opener = target.closest('[data-mobile-menu-open]');
    if (opener) {
      const dialogEl = document.getElementById('mobile-menu');
      if (dialogEl instanceof HTMLDialogElement) dialogEl.showModal();
      return;
    }

    const closer = target.closest('[data-mobile-menu-close]');
    if (closer) {
      closer.closest('dialog')?.close();
      return;
    }

    if (target instanceof HTMLDialogElement && target.hasAttribute('data-mobile-menu')) {
      target.close();
    }
  });

  // Close the menu automatically if the viewport grows past the mobile breakpoint.
  const mql = window.matchMedia('(min-width: 640px)');
  mql.addEventListener('change', (e) => {
    if (e.matches) {
      const dialogEl = document.getElementById('mobile-menu');
      if (dialogEl instanceof HTMLDialogElement && dialogEl.open) dialogEl.close();
    }
  });
</script>
