---
interface Props {
  /** CSS selector for the content element progress is measured against. Default matches ArticleLayout's article wrapper. */
  target?: string;
}

const { target = '[data-article-content]' } = Astro.props;
---

<div
  class="fixed inset-x-0 top-0 z-40 h-1 bg-transparent"
  role="progressbar"
  aria-label="Reading progress"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  data-reading-progress
  data-target={target}
>
  <div
    class="h-full w-0 bg-(--color-primary-600) transition-[width] duration-75 ease-linear"
    data-reading-progress-bar
  >
  </div>
</div>

<script>
  const track = document.querySelector<HTMLElement>('[data-reading-progress]');
  const bar = track?.querySelector<HTMLElement>('[data-reading-progress-bar]');
  const selector = track?.dataset.target;
  const target = selector ? document.querySelector<HTMLElement>(selector) : null;

  if (track && bar && target) {
    const update = () => {
      const rect = target.getBoundingClientRect();
      const viewportHeight = window.innerHeight;
      const total = rect.height - viewportHeight;
      const scrolled = -rect.top;
      const percent = total > 0 ? Math.min(100, Math.max(0, (scrolled / total) * 100)) : 0;

      bar.style.width = `${percent}%`;
      track.setAttribute('aria-valuenow', String(Math.round(percent)));
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  } else {
    // No matching content on this page (e.g. not an article) — hide silently.
    track?.remove();
  }
</script>
