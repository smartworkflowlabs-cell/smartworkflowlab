---
import { cn } from '@/lib/cn';

interface Props {
  title: string;
  /** Shared group name — when set, only one item in the group can be open (see native <details name>). */
  name?: string;
  open?: boolean;
  class?: string;
}

const { title, name, open = false, class: className, ...rest } = Astro.props;
---

<details name={name} open={open} class={cn('group', className)} data-accordion-item {...rest}>
  <summary
    class={cn(
      'flex cursor-pointer items-center justify-between gap-4 px-4 py-3 font-medium text-(--color-text)',
      'hover:bg-(--color-bg-subtle) focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-(--color-focus-ring)',
    )}
  >
    {title}
    <svg
      class="h-4 w-4 shrink-0 text-(--color-text-muted) transition-transform duration-(--duration-fast)"
      viewBox="0 0 12 12"
      fill="none"
      aria-hidden="true"
      data-accordion-chevron
    >
      <path
        d="M3 4.5L6 7.5L9 4.5"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </summary>
  <div class="px-4 pb-4 text-sm text-(--color-text-muted)">
    <slot />
  </div>
</details>
