---
import { cn } from '@/lib/cn';

interface Props {
  src?: string;
  /** Required even when `src` is set — used as alt text and as the fallback source for initials. */
  name: string;
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  /** Optional presence indicator, rendered as a dot in the corner. */
  status?: 'online' | 'offline' | 'away';
  class?: string;
}

const { src, name, size = 'md', status, class: className, ...rest } = Astro.props;

const sizes: Record<NonNullable<Props['size']>, string> = {
  xs: 'h-6 w-6 text-xs',
  sm: 'h-8 w-8 text-sm',
  md: 'h-10 w-10 text-base',
  lg: 'h-14 w-14 text-lg',
  xl: 'h-20 w-20 text-2xl',
};

const statusSizes: Record<NonNullable<Props['size']>, string> = {
  xs: 'h-1.5 w-1.5',
  sm: 'h-2 w-2',
  md: 'h-2.5 w-2.5',
  lg: 'h-3 w-3',
  xl: 'h-4 w-4',
};

const statusColors: Record<NonNullable<Props['status']>, string> = {
  online: 'bg-(--color-success-500)',
  offline: 'bg-(--color-neutral-400)',
  away: 'bg-(--color-warning-500)',
};

const initials = name
  .trim()
  .split(/\s+/)
  .slice(0, 2)
  .map((part) => part[0])
  .join('')
  .toUpperCase();
---

<span class={cn('relative inline-flex shrink-0', sizes[size], className)} {...rest}>
  {
    src ? (
      <img
        src={src}
        alt={name}
        class="h-full w-full rounded-full object-cover"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span
        class="flex h-full w-full items-center justify-center rounded-full bg-(--color-primary-100) font-medium text-(--color-primary-700)"
        role="img"
        aria-label={name}
      >
        {initials}
      </span>
    )
  }
  {
    status && (
      <span
        class={cn(
          'absolute right-0 bottom-0 rounded-full ring-2 ring-(--color-surface)',
          statusSizes[size],
          statusColors[status],
        )}
        aria-hidden="true"
      />
    )
  }
</span>
