---
import { cn } from '@/lib/cn';

interface Props {
  /** Adds hover elevation + pointer cursor — use when the whole card is clickable (wrap in <a> yourself). */
  interactive?: boolean;
  padding?: 'none' | 'sm' | 'md' | 'lg';
  class?: string;
}

const { interactive = false, padding = 'md', class: className, ...rest } = Astro.props;

const paddings: Record<NonNullable<Props['padding']>, string> = {
  none: '',
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8',
};
---

<div
  class={cn(
    'rounded-(--radius-lg) border border-(--color-border) bg-(--color-surface) shadow-(--shadow-sm)',
    paddings[padding],
    interactive && 'transition-shadow hover:shadow-(--shadow-md) focus-within:shadow-(--shadow-md)',
    className,
  )}
  {...rest}
>
  {
    Astro.slots.has('header') && (
      <div class="mb-4 flex items-center justify-between gap-4">
        <slot name="header" />
      </div>
    )
  }
  <slot />
  {
    Astro.slots.has('footer') && (
      <div class="mt-4 flex items-center gap-3 border-t border-(--color-border) pt-4">
        <slot name="footer" />
      </div>
    )
  }
</div>
