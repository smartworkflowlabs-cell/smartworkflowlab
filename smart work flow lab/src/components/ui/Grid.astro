---
import { cn } from '@/lib/cn';

interface Props {
  /** Number of columns at the base breakpoint. Default 1. */
  cols?: 1 | 2 | 3 | 4 | 6 | 12;
  /** Columns at the sm breakpoint (640px+). */
  colsSm?: 1 | 2 | 3 | 4 | 6 | 12;
  /** Columns at the md breakpoint (768px+). */
  colsMd?: 1 | 2 | 3 | 4 | 6 | 12;
  /** Columns at the lg breakpoint (1024px+). */
  colsLg?: 1 | 2 | 3 | 4 | 6 | 12;
  /** Gap between items, mapped to the spacing scale. Default 6 (1.5rem). */
  gap?: 2 | 3 | 4 | 6 | 8 | 12;
  class?: string;
}

const { cols = 1, colsSm, colsMd, colsLg, gap = 6, class: className, ...rest } = Astro.props;

const colsMap: Record<number, string> = {
  1: 'grid-cols-1',
  2: 'grid-cols-2',
  3: 'grid-cols-3',
  4: 'grid-cols-4',
  6: 'grid-cols-6',
  12: 'grid-cols-12',
};
const colsSmMap: Record<number, string> = {
  1: 'sm:grid-cols-1',
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-3',
  4: 'sm:grid-cols-4',
  6: 'sm:grid-cols-6',
  12: 'sm:grid-cols-12',
};
const colsMdMap: Record<number, string> = {
  1: 'md:grid-cols-1',
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-3',
  4: 'md:grid-cols-4',
  6: 'md:grid-cols-6',
  12: 'md:grid-cols-12',
};
const colsLgMap: Record<number, string> = {
  1: 'lg:grid-cols-1',
  2: 'lg:grid-cols-2',
  3: 'lg:grid-cols-3',
  4: 'lg:grid-cols-4',
  6: 'lg:grid-cols-6',
  12: 'lg:grid-cols-12',
};
const gapMap: Record<number, string> = {
  2: 'gap-2',
  3: 'gap-3',
  4: 'gap-4',
  6: 'gap-6',
  8: 'gap-8',
  12: 'gap-12',
};
---

<div
  class={cn(
    'grid',
    colsMap[cols],
    colsSm && colsSmMap[colsSm],
    colsMd && colsMdMap[colsMd],
    colsLg && colsLgMap[colsLg],
    gapMap[gap],
    className,
  )}
  {...rest}
>
  <slot />
</div>
