---
import BaseLayout from './BaseLayout.astro';
import { Container, Heading, Text } from '@/components/ui';
import PostCard from '@/components/blog/PostCard.astro';
import Pagination from '@/components/blog/Pagination.astro';
import type { CollectionEntry } from 'astro:content';
import type { Page } from 'astro';

interface Props {
  title: string;
  description: string;
  page: Page<CollectionEntry<'blog'>>;
  /** Route this listing lives under, for building pagination links, e.g. "/blog". */
  basePath: string;
}

const { title, description, page, basePath } = Astro.props;
const posts = page.data;
---

<BaseLayout title={title} description={description}>
  <Container size="lg" class="py-16">
    <Heading as="h1">{title}</Heading>
    <Text tone="muted" size="lg" class="mt-3 max-w-prose">{description}</Text>

    <!--
      Extra content specific to a given blog index (e.g. a featured-post
      block, a category filter row) can be slotted in above the grid.
    -->
    <slot />

    {
      posts.length > 0 ? (
        <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="mt-10 text-(--color-text-muted)">No posts yet — check back soon.</p>
      )
    }

    <Pagination page={page} basePath={basePath} />
  </Container>
</BaseLayout>
