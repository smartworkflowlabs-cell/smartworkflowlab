---
import BaseLayout from './BaseLayout.astro';
import { Container, Heading, Text, Badge } from '@/components/ui';
import PostCard from '@/components/blog/PostCard.astro';
import Pagination from '@/components/blog/Pagination.astro';
import Breadcrumb from '@/components/navigation/Breadcrumb.astro';
import { slugify } from '@/lib/content';
import type { CollectionEntry } from 'astro:content';
import type { Page } from 'astro';

interface Props {
  /** Display name, e.g. "AI Tools". */
  category: string;
  page: Page<CollectionEntry<'blog'>>;
  /** Every category in the site, for the filter row. Pass [] to hide it. */
  allCategories?: string[];
}

const { category, page, allCategories = [] } = Astro.props;
const posts = page.data;
const basePath = `/blog/category/${slugify(category)}`;
---

<BaseLayout title={`${category} — Blog`} description={`Posts filed under ${category}.`}>
  <Container size="lg" class="py-16">
    <Breadcrumb class="mb-6" items={[{ label: 'Blog', href: '/blog' }, { label: category }]} />

    <Heading as="h1">{category}</Heading>
    <Text tone="muted" size="lg" class="mt-3">
      {page.total}
      {page.total === 1 ? 'post' : 'posts'} filed under {category}.
    </Text>

    {
      allCategories.length > 1 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {allCategories.map((c) =>
            c === category ? (
              <Badge tone="primary">{c}</Badge>
            ) : (
              <a href={`/blog/category/${slugify(c)}`}>
                <Badge tone="neutral">{c}</Badge>
              </a>
            ),
          )}
        </div>
      )
    }

    {
      posts.length > 0 ? (
        <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="mt-10 text-(--color-text-muted)">No posts in this category yet.</p>
      )
    }

    <Pagination page={page} basePath={basePath} />
  </Container>
</BaseLayout>
