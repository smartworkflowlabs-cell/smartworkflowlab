---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Container, Text } from '@/components/ui';
import Breadcrumb from '@/components/navigation/Breadcrumb.astro';
import { breadcrumbSchema } from '@/lib/seo';
import { CONTACT_EMAIL } from '@/config/site';

const title = 'Contact SmartWorkflowLab';
const description =
  'Get in touch with SmartWorkflowLab. Suggest a tool to review, report a correction, ask about a guide, or discuss partnerships. We read every message.';

const structuredData = [breadcrumbSchema([{ label: 'Contact', href: '/contact' }])];

const reasons = [
  {
    title: 'Suggest a tool to review',
    body: "Using something we haven't covered? Tell us what it is and what you use it for, and it goes on our testing list.",
  },
  {
    title: 'Report a correction',
    body: "Spotted a factual error or outdated price? We want to fix it. Point us to the specific line and we'll get it sorted.",
  },
  {
    title: 'Ask about a guide',
    body: 'Stuck on something from one of our articles, or want more detail on a specific step? Ask away.',
  },
  {
    title: 'Partnerships & press',
    body: "For media, collaborations, or partnership enquiries, reach out and we'll point you to the right details.",
  },
];
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <Container size="md" class="py-12 lg:py-16">
    <Breadcrumb class="mb-6" items={[{ label: 'Contact' }]} />

    <p class="font-mono text-xs font-medium tracking-[0.15em] text-(--color-link) uppercase">
      Contact
    </p>
    <h1 class="font-display mt-3 text-3xl font-semibold text-(--color-text) sm:text-4xl">
      Get in touch
    </h1>
    <Text size="lg" tone="muted" class="mt-4">
      We're a small, independent team and we read every message. The fastest way to reach us is
      email — we usually reply within a couple of business days.
    </Text>

    <div
      class="mt-8 rounded-(--radius-xl) border border-(--color-primary-800) bg-(--color-primary-900) p-6 text-white sm:p-8"
    >
      <p class="font-mono text-xs font-medium tracking-[0.15em] text-white/60 uppercase">
        Email us
      </p>
      <a
        href={`mailto:${CONTACT_EMAIL}`}
        class="font-display mt-2 inline-block text-2xl font-semibold text-white underline underline-offset-4 hover:text-white/80 sm:text-3xl"
      >
        {CONTACT_EMAIL}
      </a>
      <Text size="sm" class="mt-3 text-white/70">
        Include as much detail as you can — the tool, the article, or the specific question — so we
        can give you a useful reply the first time.
      </Text>
    </div>

    <h2 class="font-display mt-12 text-2xl font-semibold text-(--color-text)">
      What people usually write about
    </h2>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        reasons.map((reason) => (
          <div class="rounded-(--radius-lg) border border-(--color-border) bg-(--color-surface) p-5">
            <h3 class="font-display text-base font-semibold text-(--color-text)">{reason.title}</h3>
            <Text size="sm" tone="muted" class="mt-2">
              {reason.body}
            </Text>
          </div>
        ))
      }
    </div>

    <p class="mt-10 text-sm text-(--color-text-muted)">
      Want to know more about how we work first? Read <a
        href="/about"
        class="text-(--color-link) underline underline-offset-2">about SmartWorkflowLab</a
      > and our testing method.
    </p>
  </Container>
</BaseLayout>
