---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Container, Heading, Text } from '@/components/ui';

const query = Astro.url.searchParams.get('q') ?? '';
---

<BaseLayout
  title={query ? `Search: ${query}` : 'Search'}
  description="Search SmartWorkflowLab's posts by title, description, or category."
  noindex
>
  <Container size="md" class="py-16">
    <Heading as="h1">Search</Heading>
    <Text tone="muted" size="lg" class="mt-3">
      {query ? `Results for “${query}”` : 'Search posts by title, description, or category.'}
    </Text>

    <form
      method="get"
      action="/search"
      class="mt-8 flex items-center gap-3 rounded-(--radius-lg) border border-(--color-border) p-2"
    >
      <svg
        class="ml-2 h-5 w-5 shrink-0 text-(--color-text-muted)"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
        <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"
        ></path>
      </svg>
      <input
        type="text"
        name="q"
        value={query}
        placeholder="Search posts..."
        class="flex-1 bg-transparent py-1.5 text-sm text-(--color-text) placeholder:text-(--color-text-muted) focus:outline-none"
        data-search-input
        autofocus
      />
      <button
        type="submit"
        class="rounded-(--radius-md) bg-(--color-primary-600) px-4 py-1.5 text-sm font-medium text-white hover:bg-(--color-primary-700)"
      >
        Search
      </button>
    </form>

    <ul class="mt-8 flex flex-col gap-2" data-search-results aria-live="polite">
      <li class="text-sm text-(--color-text-muted)" data-search-empty>
        {query ? 'Searching…' : 'Type a query above to search posts.'}
      </li>
    </ul>
  </Container>
</BaseLayout>

<script>
  interface SearchDoc {
    title: string;
    description: string;
    category: string;
    url: string;
  }

  const resultsList = document.querySelector<HTMLUListElement>('[data-search-results]');

  function render(docs: SearchDoc[], query: string) {
    if (!resultsList) return;
    resultsList.innerHTML = '';

    if (!query) {
      resultsList.innerHTML =
        '<li class="text-sm text-(--color-text-muted)">Type a query above to search posts.</li>';
      return;
    }

    if (docs.length === 0) {
      resultsList.innerHTML =
        '<li class="text-sm text-(--color-text-muted)">No results for “' +
        query.replace(/</g, '&lt;') +
        '”.</li>';
      return;
    }

    for (const doc of docs) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = doc.url;
      a.className =
        'block rounded-(--radius-lg) border border-(--color-border) p-4 hover:bg-(--color-bg-subtle)';
      a.innerHTML =
        '<span class="block font-medium text-(--color-text)">' +
        doc.title.replace(/</g, '&lt;') +
        '</span><span class="mt-1 block text-sm text-(--color-text-muted)">' +
        doc.description.replace(/</g, '&lt;') +
        '</span><span class="mt-2 inline-block text-xs font-medium text-(--color-link)">' +
        doc.category.replace(/</g, '&lt;') +
        '</span>';
      li.appendChild(a);
      resultsList.appendChild(li);
    }
  }

  async function runSearch() {
    const query = new URLSearchParams(window.location.search).get('q')?.trim() ?? '';
    if (!query) {
      render([], '');
      return;
    }

    const [docs, { default: Fuse }] = await Promise.all([
      fetch('/search-index.json').then((res) => res.json() as Promise<SearchDoc[]>),
      import('fuse.js'),
    ]);
    const fuse = new Fuse(docs, { keys: ['title', 'description', 'category'], threshold: 0.35 });
    render(
      fuse.search(query).map((r) => r.item),
      query,
    );
  }

  runSearch();
</script>
