---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getImage } from 'astro:assets';
import { Container, Heading, Text, Badge } from '@/components/ui';
import Breadcrumb from '@/components/navigation/Breadcrumb.astro';
import CoverImage from '@/components/media/CoverImage.astro';
import { formatDate } from '@/lib/content';
import { howToSchema, faqSchema, breadcrumbSchema } from '@/lib/seo';

export async function getStaticPaths() {
  const recipes = await getCollection('workflow', ({ data }) => !data.draft);
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe, all: recipes },
  }));
}

const { recipe, all } = Astro.props;
const {
  title,
  description,
  goal,
  tools,
  difficulty,
  timeToSetup,
  steps,
  cover,
  coverAlt,
  pubDate,
  updatedDate,
  author,
  related,
  faq,
} = recipe.data;
const { Content } = await render(recipe);

const relatedRecipes = related
  .map((slug) => all.find((r) => r.id === slug))
  .filter((r): r is (typeof all)[number] => Boolean(r));

const structuredData = [
  howToSchema({
    name: title,
    description,
    steps,
    totalTime: timeToSetup,
  }),
  ...(faq && faq.length > 0 ? [faqSchema(faq)] : []),
  breadcrumbSchema([
    { label: 'Workflows', href: '/workflows' },
    { label: title, href: `/workflows/${recipe.id}` },
  ]),
];

const preloadCover = cover
  ? await getImage({ src: cover, width: 1200, format: 'webp', quality: 75 })
  : null;
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  ogImage={cover?.src}
  articlePublishedTime={pubDate.toISOString()}
  articleModifiedTime={(updatedDate ?? pubDate).toISOString()}
  articleAuthor={author.name}
  preloadImageUrl={preloadCover?.src}
  structuredData={structuredData}
>
  <Container size="md" class="py-12 lg:py-16">
    <Breadcrumb
      class="mb-6"
      items={[{ label: 'Workflows', href: '/workflows' }, { label: title }]}
    />

    <div class="flex flex-wrap items-center gap-2">
      <Badge tone="primary">Workflow Recipe</Badge>
      <Badge tone="neutral">{difficulty}</Badge>
      {
        timeToSetup && (
          <Text size="sm" tone="muted" as="span">
            ⏱ {timeToSetup} setup
          </Text>
        )
      }
    </div>

    <Heading as="h1" class="mt-3">{title}</Heading>

    <!-- Goal + tools summary box -->
    <div
      class="mt-6 rounded-(--radius-lg) border border-(--color-border) bg-(--color-bg-subtle) p-5"
    >
      <p class="font-mono text-[11px] font-medium tracking-[0.15em] text-(--color-link) uppercase">
        The goal
      </p>
      <p class="mt-1.5 text-(--color-text)">{goal}</p>
      {
        tools.length > 0 && (
          <div class="mt-4 flex flex-wrap items-center gap-2">
            <span class="text-xs font-medium text-(--color-text-muted)">Tools:</span>
            {tools.map((t) => (
              <span class="rounded-(--radius-sm) border border-(--color-border) bg-(--color-surface) px-2 py-0.5 text-xs text-(--color-text)">
                {t}
              </span>
            ))}
          </div>
        )
      }
    </div>

    {
      cover && (
        <CoverImage src={cover} alt={coverAlt ?? ''} class="mt-8 rounded-(--radius-lg)" priority />
      )
    }

    <!-- Intro prose -->
    <div
      class:list={[
        'prose prose-neutral dark:prose-invert mt-10 max-w-none',
        'prose-headings:font-display prose-headings:font-semibold',
        'prose-a:text-(--color-link) prose-a:no-underline hover:prose-a:underline',
      ]}
    >
      <Content />
    </div>

    <!-- Numbered steps -->
    {
      steps.length > 0 && (
        <section class="mt-12">
          <h2 class="font-display text-2xl font-semibold text-(--color-text)">
            Step-by-step guide
          </h2>
          <ol class="mt-6 space-y-4">
            {steps.map((step, i) => (
              <li class="flex gap-4 rounded-(--radius-lg) border border-(--color-border) bg-(--color-surface) p-5">
                <span
                  class="font-display flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-(--color-primary-900) text-sm font-semibold text-white"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                <div class="min-w-0">
                  <h3 class="font-display font-semibold text-(--color-text)">{step.title}</h3>
                  <Text size="sm" tone="muted" class="mt-1">
                    {step.description}
                  </Text>
                </div>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <!-- FAQ -->
    {
      faq && faq.length > 0 && (
        <section class="mt-12">
          <h2 class="font-display text-2xl font-semibold text-(--color-text)">
            Frequently asked questions
          </h2>
          <div class="mt-4 space-y-3">
            {faq.map((item) => (
              <details class="rounded-(--radius-lg) border border-(--color-border) bg-(--color-surface) p-4">
                <summary class="cursor-pointer font-medium text-(--color-text) select-none">
                  {item.question}
                </summary>
                <p class="mt-3 text-sm text-(--color-text-muted)">{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }

    <!-- Related recipes -->
    {
      relatedRecipes.length > 0 && (
        <div class="mt-12 border-t border-(--color-border) pt-8">
          <h2 class="font-display text-lg font-semibold text-(--color-text)">
            More workflow recipes
          </h2>
          <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
            {relatedRecipes.map((r) => (
              <a
                href={`/workflows/${r.id}`}
                class="group rounded-(--radius-lg) border border-(--color-border) bg-(--color-surface) p-4 transition-shadow hover:shadow-(--shadow-md)"
              >
                <p class="font-medium text-(--color-text) group-hover:text-(--color-link)">
                  {r.data.title}
                </p>
                <p class="mt-1 line-clamp-2 text-xs text-(--color-text-muted)">{r.data.goal}</p>
              </a>
            ))}
          </div>
        </div>
      )
    }

    <Text size="xs" tone="muted" class="mt-10">
      Last updated {formatDate(updatedDate ?? pubDate)}
    </Text>
  </Container>
</BaseLayout>
