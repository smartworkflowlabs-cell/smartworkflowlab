---
import { Card, Button, Heading, Text } from '@/components/ui';
import CoverImage from '@/components/media/CoverImage.astro';
import { AFFILIATE_DISCLOSURE } from '@/config/affiliate';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  price?: string;
  /** Why this is the pick — a sentence or two, shown prominently. */
  reason: string;
  ctaLabel?: string;
  ctaHref: string;
  /** Corner ribbon text. Default "Best Choice". */
  label?: string;
  showDisclosure?: boolean;
  class?: string;
}

const {
  name,
  image,
  imageAlt,
  price,
  reason,
  ctaLabel = 'Get it now',
  ctaHref,
  label = 'Best Choice',
  showDisclosure = true,
  class: className,
} = Astro.props;

const isLocalImage = typeof image === 'object';
---

<Card
  padding="none"
  class={`not-prose relative flex flex-col overflow-hidden border-2 border-(--color-accent-500) sm:flex-row ${className ?? ''}`}
>
  <span
    class="absolute top-3 right-3 z-10 rounded-full bg-(--color-accent-700) px-3 py-1 text-xs font-semibold text-white shadow-(--shadow-sm)"
  >
    ★ {label}
  </span>

  {
    image &&
      (isLocalImage ? (
        <CoverImage
          src={image as ImageMetadata}
          alt={imageAlt ?? name}
          widths={[300, 500, 700]}
          sizes="(min-width: 640px) 320px, 100vw"
          class="sm:w-64 sm:shrink-0"
        />
      ) : (
        <img
          src={image as string}
          alt={imageAlt ?? name}
          loading="lazy"
          decoding="async"
          class="aspect-video w-full object-cover sm:aspect-auto sm:h-full sm:w-64 sm:shrink-0"
        />
      ))
  }

  <div class="flex flex-1 flex-col justify-center p-6">
    <Heading as="h3" size="sm" class="mb-2">{name}</Heading>
    <Text tone="muted" class="mb-4">{reason}</Text>

    <div class="mt-auto flex items-center justify-between gap-3">
      {price && <Text class="font-semibold text-(--color-text)">{price}</Text>}
      <Button href={ctaHref} rel="sponsored noopener" target="_blank" class="ml-auto">
        {ctaLabel}
      </Button>
    </div>

    {
      showDisclosure && (
        <Text size="xs" tone="muted" class="mt-3">
          {AFFILIATE_DISCLOSURE}
        </Text>
      )
    }
  </div>
</Card>
