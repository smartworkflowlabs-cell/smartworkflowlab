---
import { Button, Text } from '@/components/ui';
import CoverImage from '@/components/media/CoverImage.astro';
import { AFFILIATE_DISCLOSURE } from '@/config/affiliate';
import { cn } from '@/lib/cn';
import type { ImageMetadata } from 'astro';

interface Product {
  name: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  price?: string;
  ctaLabel?: string;
  ctaHref: string;
  /** Values keyed by the same `key`s used in `features`. Booleans render as check/cross; strings render as-is. */
  specs: Record<string, string | boolean>;
  /** Marks this column as the recommended pick — adds an accent border and a ribbon. */
  highlight?: boolean;
}

interface Feature {
  key: string;
  label: string;
}

interface Props {
  products: Product[];
  features: Feature[];
  caption: string;
  class?: string;
}

const { products, features, caption, class: className } = Astro.props;
---

<figure class={cn('not-prose my-8', className)}>
  <div class="overflow-x-auto rounded-(--radius-lg) border border-(--color-border)">
    <table class="w-full min-w-[640px] border-collapse text-sm">
      <caption class="sr-only">{caption}</caption>
      <thead>
        <tr class="border-b border-(--color-border) bg-(--color-bg-subtle)">
          <th
            scope="col"
            class="w-40 px-4 py-4 text-left align-bottom font-medium text-(--color-text-muted)"
          >
            <span class="sr-only">Feature</span>
          </th>
          {
            products.map((product) => (
              <th
                scope="col"
                class={cn(
                  'min-w-[180px] px-4 py-4 text-left align-bottom',
                  product.highlight && 'bg-(--color-accent-500)/10',
                )}
              >
                <div class="flex flex-col gap-2">
                  {product.highlight && (
                    <span class="w-fit rounded-full bg-(--color-accent-700) px-2.5 py-0.5 text-xs font-semibold text-white">
                      ★ Best Choice
                    </span>
                  )}
                  {product.image &&
                    (typeof product.image === 'object' ? (
                      <CoverImage
                        src={product.image as ImageMetadata}
                        alt={product.imageAlt ?? product.name}
                        widths={[160, 240]}
                        sizes="160px"
                        class="w-24 rounded-(--radius-md)"
                      />
                    ) : (
                      <img
                        src={product.image as string}
                        alt={product.imageAlt ?? product.name}
                        loading="lazy"
                        decoding="async"
                        class="aspect-square w-24 rounded-(--radius-md) object-cover"
                      />
                    ))}
                  <span class="font-semibold text-(--color-text)">{product.name}</span>
                  {product.price && <span class="text-(--color-text-muted)">{product.price}</span>}
                  <Button
                    href={product.ctaHref}
                    rel="sponsored noopener"
                    target="_blank"
                    size="sm"
                    variant={product.highlight ? 'primary' : 'secondary'}
                  >
                    {product.ctaLabel ?? 'View deal'}
                  </Button>
                </div>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          features.map((feature) => (
            <tr class="border-b border-(--color-border) last:border-0">
              <th scope="row" class="px-4 py-3 text-left font-medium text-(--color-text)">
                {feature.label}
              </th>
              {products.map((product) => {
                const value = product.specs[feature.key];
                return (
                  <td
                    class={cn(
                      'px-4 py-3 text-(--color-text)',
                      product.highlight && 'bg-(--color-accent-500)/5',
                    )}
                  >
                    {typeof value === 'boolean' ? (
                      value ? (
                        <svg
                          class="h-4 w-4 text-(--color-success-500)"
                          viewBox="0 0 16 16"
                          fill="none"
                          aria-label="Yes"
                        >
                          <path
                            d="M13.5 4.5L6 12L2.5 8.5"
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      ) : (
                        <svg
                          class="h-4 w-4 text-(--color-text-muted)"
                          viewBox="0 0 16 16"
                          fill="none"
                          aria-label="No"
                        >
                          <path
                            d="M12 4L4 12M4 4l8 8"
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      )
                    ) : (
                      (value ?? '—')
                    )}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <Text size="xs" tone="muted" class="mt-2">{AFFILIATE_DISCLOSURE}</Text>
</figure>
