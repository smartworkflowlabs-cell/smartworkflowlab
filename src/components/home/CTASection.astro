---
import { Container, Button } from '@/components/ui';
import SectionHeading from './SectionHeading.astro';
---

<section class="bg-(--color-primary-900) py-16 lg:py-24">
  <Container size="md" class="text-center">
    <SectionHeading
      kicker="How we test"
      heading="We buy the subscriptions so you don't have to."
      description="Every tool we recommend gets used in a real workflow for at least two weeks before we write a word about it. If it doesn't earn its price, we say so."
      align="center"
      tone="inverse"
    />
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href="/blog/category/ai-tools" size="lg">Browse tool reviews</Button>
      <Button
        href="/blog"
        variant="secondary"
        size="lg"
        class="border-white/30 bg-transparent text-white hover:bg-white/10"
      >
        Read the blog
      </Button>
    </div>
  </Container>
</section>
