---
import { Button, Badge, Avatar, Text } from '@/components/ui';
import { formatDate } from '@/lib/content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  latestPost: CollectionEntry<'blog'>;
}

const { latestPost } = Astro.props;
const { title, description, category, author, pubDate } = latestPost.data;
---

<section class="border-b border-(--color-border)">
  <div
    class="mx-auto grid max-w-(--container-max) grid-cols-1 gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[1.2fr_1fr] lg:items-center lg:gap-16 lg:px-8 lg:py-24"
  >
    <div>
      <p class="font-mono text-xs font-medium tracking-[0.15em] text-(--color-link) uppercase">
        SmartWorkflowLab — Issue 12
      </p>
      <h1
        class="font-display mt-4 text-4xl leading-[1.05] font-semibold text-balance text-(--color-text) sm:text-5xl lg:text-6xl"
      >
        Stop collecting AI tools. Start finishing things.
      </h1>
      <p class="mt-6 max-w-lg text-lg text-(--color-text-muted)">
        SmartWorkflowLab tests AI productivity tools and workflow automations so you don't have
        to — what's worth paying for, what's overhyped, and how to actually put it to work.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/blog" size="lg">Start reading</Button>
        <Button href="#categories" variant="secondary" size="lg">Browse categories</Button>
      </div>
    </div>

    <a
      href={`/blog/${latestPost.id}`}
      class="group relative block rounded-(--radius-xl) border border-(--color-border) bg-(--color-surface) p-6 shadow-(--shadow-md) transition-shadow hover:shadow-(--shadow-lg) sm:p-8"
    >
      <p
        class="font-mono text-xs font-medium tracking-[0.15em] text-(--color-text-muted) uppercase"
      >
        Just tested
      </p>
      <div class="mt-4 flex items-center gap-2">
        <Badge tone="primary">{category}</Badge>
        <Text size="xs" tone="muted" as="span">{formatDate(pubDate)}</Text>
      </div>
      <h2
        class="font-display mt-4 text-2xl font-semibold text-(--color-text) group-hover:text-(--color-primary-700) sm:text-3xl"
      >
        {title}
      </h2>
      <p class="mt-3 text-(--color-text-muted)">{description}</p>
      <div class="mt-6 flex items-center gap-2">
        <Avatar name={author.name} src={author.avatar} size="xs" />
        <Text size="sm" tone="muted">{author.name}</Text>
      </div>
      <span
        class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-(--color-link)"
        aria-hidden="true"
      >
        Read now
        <svg
          class="h-3 w-3 transition-transform group-hover:translate-x-0.5"
          viewBox="0 0 12 12"
          fill="none"
        >
          <path
            d="M2 6h8m0 0L6.5 2.5M10 6L6.5 9.5"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </a>
  </div>
</section>
