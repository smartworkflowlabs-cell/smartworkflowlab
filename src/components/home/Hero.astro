---
import { Button, Badge, Text } from '@/components/ui';
import { formatDate } from '@/lib/content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  latestPost: CollectionEntry<'blog'>;
}

const { latestPost } = Astro.props;
const { title, category, pubDate } = latestPost.data;

/**
 * Editorial trust numbers shown in the stat strip.
 * Update these by hand as coverage grows — they are claims, keep them honest.
 */
const stats = [
  { value: '40+', label: 'tools tested hands-on' },
  { value: '2 wks', label: 'minimum test period' },
  { value: '0', label: 'sponsored reviews' },
];
---

<section class="hero-grid-bg relative overflow-hidden border-b border-(--color-border)">
  <div
    class="relative mx-auto grid max-w-(--container-max) grid-cols-1 gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-16 lg:px-8 lg:py-24"
  >
    <div>
      <p class="font-mono text-xs font-medium tracking-[0.15em] text-(--color-link) uppercase">
        SmartWorkflowLab — Issue 12
      </p>
      <h1
        class="font-display mt-4 text-4xl leading-[1.05] font-semibold text-balance text-(--color-text) sm:text-5xl lg:text-6xl"
      >
        Stop collecting AI tools. Start finishing things.
      </h1>
      <p class="mt-6 max-w-lg text-lg text-(--color-text-muted)">
        We run AI productivity tools and workflow automations inside real work for weeks before
        writing a word — so you know what's worth paying for, what's overhyped, and how to actually
        put it to use.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/blog/category/ai-tools" size="lg">Browse tool reviews</Button>
        <Button href="/blog" variant="secondary" size="lg">Read the latest</Button>
      </div>

      <dl class="mt-10 grid max-w-lg grid-cols-3 gap-4 border-t border-(--color-border) pt-6">
        {
          stats.map((stat) => (
            <div>
              <dd class="font-display text-2xl font-semibold text-(--color-text) sm:text-3xl">
                {stat.value}
              </dd>
              <dt class="mt-1 text-xs leading-snug text-(--color-text-muted)">{stat.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>

    <div>
      <!-- Signature: a live workflow pipeline — the thing this site is about, running. -->
      <div
        class="rounded-(--radius-xl) border border-(--color-border) bg-(--color-surface) shadow-(--shadow-md)"
        aria-label="Illustration of an automated workflow: a trigger, an AI step, then done"
        role="img"
      >
        <div
          class="flex items-center justify-between border-b border-(--color-border) px-5 py-3 sm:px-6"
        >
          <p
            class="font-mono text-[11px] font-medium tracking-[0.15em] text-(--color-text-muted) uppercase"
          >
            Workflow · live in the lab
          </p>
          <span class="flex items-center gap-1.5" aria-hidden="true">
            <span class="pipeline-status-dot h-1.5 w-1.5 rounded-full bg-(--color-success-500)"
            ></span>
            <span class="font-mono text-[11px] text-(--color-text-muted)">running</span>
          </span>
        </div>

        <div class="px-5 py-6 sm:px-6" aria-hidden="true">
          <div class="pipeline">
            <div class="pipeline-node">
              <span class="pipeline-node-icon border-(--color-primary-300) text-(--color-link)">
                <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4">
                  <path
                    d="M4 6a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm2 1l6 4.5L18 7"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </span>
              <p class="pipeline-node-kicker">Trigger</p>
              <p class="pipeline-node-label">Meeting notes land in your inbox</p>
            </div>

            <div class="pipeline-connector">
              <span class="pipeline-packet"></span>
            </div>

            <div class="pipeline-node">
              <span
                class="pipeline-node-icon border-(--color-accent-300) text-(--color-accent-700)"
              >
                <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4">
                  <path
                    d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3zM18 15l.9 2.1L21 18l-2.1.9L18 21l-.9-2.1L15 18l2.1-.9L18 15z"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </span>
              <p class="pipeline-node-kicker">AI step</p>
              <p class="pipeline-node-label">Drafts action items &amp; assigns owners</p>
            </div>

            <div class="pipeline-connector">
              <span class="pipeline-packet pipeline-packet-late"></span>
            </div>

            <div class="pipeline-node">
              <span
                class="pipeline-node-icon border-(--color-success-500) text-(--color-success-text)"
              >
                <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4">
                  <path
                    d="M5 13l4 4L19 7"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </span>
              <p class="pipeline-node-kicker">Done</p>
              <p class="pipeline-node-label">In your task manager — 25 min saved</p>
            </div>
          </div>
        </div>

        <a
          href={`/blog/${latestPost.id}`}
          class="group flex items-center gap-3 border-t border-(--color-border) bg-(--color-bg-subtle) px-5 py-4 transition-colors hover:bg-(--color-surface) sm:px-6"
        >
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <p
                class="font-mono text-[11px] font-medium tracking-[0.15em] text-(--color-text-muted) uppercase"
              >
                Just tested
              </p>
              <Badge tone="primary">{category}</Badge>
              <Text size="xs" tone="muted" as="span">{formatDate(pubDate)}</Text>
            </div>
            <p
              class="mt-1.5 truncate text-sm font-medium text-(--color-text) group-hover:text-(--color-primary-700)"
            >
              {title}
            </p>
          </div>
          <svg
            class="h-4 w-4 shrink-0 text-(--color-text-muted) transition-transform group-hover:translate-x-1"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M2 6h8m0 0L6.5 2.5M10 6L6.5 9.5"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Subtle dot grid confined to the hero — quiet texture, not decoration noise. */
  .hero-grid-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--color-border) 1px, transparent 1px);
    background-size: 26px 26px;
    mask-image: radial-gradient(ellipse 90% 80% at 70% 20%, black 0%, transparent 70%);
    pointer-events: none;
  }

  .pipeline {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: start;
    gap: 0.5rem;
  }

  .pipeline-node {
    text-align: center;
  }

  .pipeline-node-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    border-width: 1.5px;
    background: var(--color-surface);
  }

  .pipeline-node-kicker {
    margin-top: 0.625rem;
    font-family: var(--font-mono, monospace);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .pipeline-node-label {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--color-text);
  }

  .pipeline-connector {
    position: relative;
    margin-top: 1.25rem; /* aligns with icon centers */
    height: 2px;
    min-width: 1.5rem;
    background-image: linear-gradient(to right, var(--color-border-strong) 50%, transparent 50%);
    background-size: 8px 2px;
  }

  .pipeline-packet {
    position: absolute;
    top: 50%;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--color-primary-500);
    transform: translate(0, -50%);
    animation: packet-travel 2.8s ease-in-out infinite;
  }

  .pipeline-packet-late {
    background: var(--color-accent-500);
    animation-delay: 1.4s;
  }

  .pipeline-status-dot {
    animation: status-pulse 2.8s ease-in-out infinite;
  }

  @keyframes packet-travel {
    0% {
      left: 0%;
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    45% {
      left: calc(100% - 6px);
      opacity: 1;
    }
    60%,
    100% {
      left: calc(100% - 6px);
      opacity: 0;
    }
  }

  @keyframes status-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pipeline-packet,
    .pipeline-status-dot {
      animation: none;
    }
    .pipeline-packet {
      left: calc(50% - 3px);
      opacity: 1;
    }
  }

  @media (max-width: 480px) {
    .pipeline {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0.75rem;
    }
    .pipeline-connector {
      margin-top: 0;
      width: 2px;
      height: 1.25rem;
      min-width: 0;
      background-image: linear-gradient(to bottom, var(--color-border-strong) 50%, transparent 50%);
      background-size: 2px 8px;
    }
    .pipeline-packet {
      animation: packet-travel-vertical 2.8s ease-in-out infinite;
      left: 50%;
      transform: translate(-50%, 0);
    }
    @keyframes packet-travel-vertical {
      0% {
        top: 0%;
        opacity: 0;
      }
      15% {
        opacity: 1;
      }
      45% {
        top: calc(100% - 6px);
        opacity: 1;
      }
      60%,
      100% {
        top: calc(100% - 6px);
        opacity: 0;
      }
    }
  }
</style>
