---
/**
 * HeroSection — professional hero matching reference design.
 * Left: badge, headline, subtitle, 2 CTAs
 * Right: SVG workspace illustration with floating tool icons
 * Bottom: trust signals strip with icons
 * Background: subtle gradient mesh
 */
import { Button } from '@/components/ui';
---

<section class="hero" data-reveal-root>
  <!-- Background -->
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__gradient"></div>
    <div class="hero__grid-lines"></div>
  </div>

  <div class="hero__container">
    <div class="hero__layout">
      <!-- LEFT: Copy -->
      <div class="hero__copy">
        <div class="hero__badge fx-enter" style="--enter-delay:100ms">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Smarter Tools. Better Workflow.</span>
        </div>

        <h1 class="hero__h1 fx-enter" style="--enter-delay:200ms">
          Powerful AI Tools<br/>& Guides for<br/>
          <span class="hero__h1-accent">Modern Professionals</span>
        </h1>

        <p class="hero__sub fx-enter" style="--enter-delay:350ms">
          Discover handpicked AI tools, practical guides, and expert resources
          to help you work smarter, save time, and stay ahead.
        </p>

        <div class="hero__actions fx-enter" style="--enter-delay:480ms">
          <Button href="/directory" size="lg">
            Explore Tools
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10m0 0L9.5 4.5M13 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </Button>
          <Button href="/blog" variant="secondary" size="lg">
            Read Guides
          </Button>
        </div>
      </div>

      <!-- RIGHT: Visual -->
      <div class="hero__visual fx-enter" style="--enter-delay:300ms">
        <div class="hero__scene">
          <!-- Laptop SVG -->
          <svg class="hero__laptop" viewBox="0 0 520 360" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Laptop body -->
            <rect x="60" y="30" width="400" height="260" rx="12" fill="var(--color-surface)" stroke="var(--color-border-strong)" stroke-width="1.5"/>
            <!-- Screen -->
            <rect x="75" y="45" width="370" height="225" rx="4" fill="var(--color-bg-subtle)"/>
            <!-- Screen content lines -->
            <rect x="95" y="70" width="140" height="8" rx="4" fill="var(--color-primary-200)" opacity="0.7"/>
            <rect x="95" y="90" width="200" height="6" rx="3" fill="var(--color-border)" opacity="0.5"/>
            <rect x="95" y="106" width="160" height="6" rx="3" fill="var(--color-border)" opacity="0.4"/>
            <!-- Screen cards -->
            <rect x="95" y="130" width="150" height="80" rx="8" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="1"/>
            <rect x="260" y="130" width="150" height="80" rx="8" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="1"/>
            <rect x="110" y="145" width="60" height="6" rx="3" fill="var(--color-primary-300)"/>
            <rect x="110" y="160" width="100" height="4" rx="2" fill="var(--color-border)"/>
            <rect x="110" y="172" width="80" height="4" rx="2" fill="var(--color-border)" opacity="0.6"/>
            <rect x="275" y="145" width="60" height="6" rx="3" fill="var(--color-accent-400)"/>
            <rect x="275" y="160" width="100" height="4" rx="2" fill="var(--color-border)"/>
            <rect x="275" y="172" width="80" height="4" rx="2" fill="var(--color-border)" opacity="0.6"/>
            <!-- Status bar -->
            <rect x="95" y="230" width="320" height="24" rx="4" fill="var(--color-primary-100)" opacity="0.3"/>
            <rect x="105" y="237" width="80" height="10" rx="5" fill="var(--color-primary-400)" opacity="0.6"/>
            <!-- Laptop base -->
            <path d="M40 290 L60 290 L60 290 L460 290 L480 290 L480 300 C480 308 474 314 466 314 L54 314 C46 314 40 308 40 300 Z" fill="var(--color-surface-raised)" stroke="var(--color-border-strong)" stroke-width="1.5"/>
            <rect x="210" y="295" width="100" height="6" rx="3" fill="var(--color-border)"/>
          </svg>

          <!-- Floating tool icons -->
          <div class="hero__float hero__float--1">
            <div class="hero__float-icon hero__float-icon--green">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          </div>
          <div class="hero__float hero__float--2">
            <div class="hero__float-icon hero__float-icon--blue">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          </div>
          <div class="hero__float hero__float--3">
            <div class="hero__float-icon hero__float-icon--purple">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M12 2v4m0 12v4M2 12h4m12 0h4" stroke-linecap="round"/></svg>
            </div>
          </div>
          <div class="hero__float hero__float--4">
            <div class="hero__float-icon hero__float-icon--orange">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          </div>
          <div class="hero__float hero__float--5">
            <div class="hero__float-icon hero__float-icon--pink">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l2.4 7.4H22l-6 4.6 2.3 7.4-6.3-4.6L5.7 21.4 8 14 2 9.4h7.6z" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          </div>

          <!-- "Better Tools" label -->
          <div class="hero__label fx-glass">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-500)" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/><path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <div>
              <strong>Better Tools</strong><br/>
              <span>Bigger Possibilities</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Trust signals strip -->
    <div class="hero__trust fx-enter" style="--enter-delay:600ms">
      <div class="hero__trust-item">
        <span class="hero__trust-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <div>
          <strong>Trusted Resources</strong>
          <span>Real tools, real guides</span>
        </div>
      </div>
      <div class="hero__trust-item">
        <span class="hero__trust-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <div>
          <strong>Save Time</strong>
          <span>Work smarter, not harder</span>
        </div>
      </div>
      <div class="hero__trust-item">
        <span class="hero__trust-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <div>
          <strong>Updated Regularly</strong>
          <span>New tools & articles weekly</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--header-height) + 2rem);
    padding-bottom: 0;
  }

  /* Background */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero__gradient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 50% at 20% 20%, color-mix(in oklch, var(--color-primary-100) 40%, transparent), transparent),
      radial-gradient(ellipse 50% 60% at 80% 30%, color-mix(in oklch, var(--color-primary-50) 60%, transparent), transparent),
      radial-gradient(ellipse 60% 40% at 60% 80%, color-mix(in oklch, var(--color-accent-50) 30%, transparent), transparent);
  }
  :global([data-theme='dark']) .hero__gradient {
    background:
      radial-gradient(ellipse 70% 50% at 20% 20%, color-mix(in oklch, var(--color-primary-900) 30%, transparent), transparent),
      radial-gradient(ellipse 50% 60% at 80% 30%, color-mix(in oklch, var(--color-primary-950) 40%, transparent), transparent);
  }
  .hero__grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, color-mix(in oklch, var(--color-primary-400) 4%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklch, var(--color-primary-400) 4%, transparent) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 60% 50% at 70% 30%, black 20%, transparent 70%);
  }

  /* Container */
  .hero__container {
    position: relative;
    z-index: 1;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Layout */
  .hero__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    min-height: 480px;
    padding: 2rem 0 3rem;
  }

  @media (max-width: 900px) {
    .hero__layout {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2.5rem;
      min-height: auto;
    }
    .hero__actions { justify-content: center; }
    .hero__visual { order: -1; max-width: 420px; margin: 0 auto; }
  }

  /* Badge */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.85rem 0.3rem 0.6rem;
    border-radius: var(--radius-full);
    background: color-mix(in oklch, var(--color-primary-100) 60%, var(--color-surface));
    border: 1px solid color-mix(in oklch, var(--color-primary-200) 50%, var(--color-border));
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary-600);
    margin-bottom: 1.5rem;
  }
  :global([data-theme='dark']) .hero__badge {
    background: color-mix(in oklch, var(--color-primary-900) 40%, var(--color-surface));
    border-color: color-mix(in oklch, var(--color-primary-700) 30%, var(--color-border));
    color: var(--color-primary-300);
  }

  /* Headline */
  .hero__h1 {
    font-family: var(--font-body);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }
  .hero__h1-accent {
    background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Sub */
  .hero__sub {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    max-width: 420px;
    margin-bottom: 2rem;
  }
  @media (max-width: 900px) {
    .hero__sub { margin-inline: auto; }
  }

  /* Actions */
  .hero__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* ===== VISUAL ===== */
  .hero__scene {
    position: relative;
    width: 100%;
    aspect-ratio: 520/360;
  }

  .hero__laptop {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 20px 40px color-mix(in oklch, var(--color-neutral-900) 15%, transparent));
  }

  /* Floating icons */
  .hero__float {
    position: absolute;
    z-index: 2;
    animation: hero-float 5s ease-in-out infinite;
  }
  .hero__float--1 { top: 2%; left: 8%; animation-delay: 0s; }
  .hero__float--2 { top: 0%; left: 42%; animation-delay: 0.8s; }
  .hero__float--3 { top: 12%; right: 5%; animation-delay: 1.5s; }
  .hero__float--4 { bottom: 30%; right: -2%; animation-delay: 0.5s; }
  .hero__float--5 { bottom: 25%; left: -2%; animation-delay: 2s; }

  @keyframes hero-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .hero__float-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-md);
    transition: transform 0.3s var(--ease-out);
  }
  .hero__float-icon:hover { transform: scale(1.15); }

  .hero__float-icon--green {
    background: linear-gradient(135deg, #d1fae5, #a7f3d0);
    color: #059669;
  }
  .hero__float-icon--blue {
    background: linear-gradient(135deg, #dbeafe, #bfdbfe);
    color: #2563eb;
  }
  .hero__float-icon--purple {
    background: linear-gradient(135deg, #ede9fe, #ddd6fe);
    color: #7c3aed;
  }
  .hero__float-icon--orange {
    background: linear-gradient(135deg, #ffedd5, #fed7aa);
    color: #ea580c;
  }
  .hero__float-icon--pink {
    background: linear-gradient(135deg, #fce7f3, #fbcfe8);
    color: #db2777;
  }
  :global([data-theme='dark']) .hero__float-icon--green { background: linear-gradient(135deg, #064e3b, #065f46); color: #6ee7b7; }
  :global([data-theme='dark']) .hero__float-icon--blue { background: linear-gradient(135deg, #1e3a5f, #1e40af); color: #93c5fd; }
  :global([data-theme='dark']) .hero__float-icon--purple { background: linear-gradient(135deg, #3b0764, #4c1d95); color: #c4b5fd; }
  :global([data-theme='dark']) .hero__float-icon--orange { background: linear-gradient(135deg, #431407, #7c2d12); color: #fdba74; }
  :global([data-theme='dark']) .hero__float-icon--pink { background: linear-gradient(135deg, #500724, #831843); color: #f9a8d4; }

  /* Label badge */
  .hero__label {
    position: absolute;
    bottom: 22%;
    right: 2%;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius-lg);
    font-size: 0.6875rem;
    line-height: 1.35;
    box-shadow: var(--shadow-md);
    animation: hero-float 6s ease-in-out infinite 1s;
  }
  .hero__label strong {
    display: block;
    color: var(--color-text);
    font-weight: 600;
  }
  .hero__label span {
    color: var(--color-text-muted);
  }

  /* ===== TRUST STRIP ===== */
  .hero__trust {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
    margin-top: 1rem;
  }
  @media (max-width: 640px) {
    .hero__trust { grid-template-columns: 1fr; gap: 1rem; }
  }

  .hero__trust-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .hero__trust-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: color-mix(in oklch, var(--color-primary-100) 50%, var(--color-surface));
    color: var(--color-primary-500);
    flex-shrink: 0;
  }
  :global([data-theme='dark']) .hero__trust-icon {
    background: color-mix(in oklch, var(--color-primary-800) 30%, var(--color-surface));
    color: var(--color-primary-300);
  }
  .hero__trust-item strong {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .hero__trust-item span {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__float { animation: none !important; }
    .hero__label { animation: none !important; }
  }
</style>
