---
/**
 * NewsletterBanner — full-width dark/primary colored newsletter CTA.
 * Matches reference: dark background, kicker badge, headline, subtitle,
 * email input with submit button on the right.
 */
import { Container } from '@/components/ui';
---

<section class="nb">
  <Container size="lg">
    <div class="nb__card" data-reveal>
      <div class="nb__glow" aria-hidden="true"></div>

      <div class="nb__layout">
        <div class="nb__copy">
          <div class="nb__kicker">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>STAY UPDATED</span>
          </div>
          <h2 class="nb__title">
            Get the Best Tools & Guides<br/>
            Delivered to Your Inbox
          </h2>
          <p class="nb__sub">
            Join our newsletter and never miss the latest AI tools, tips, and tutorials.
          </p>
        </div>

        <div class="nb__form-wrap">
          <form class="nb__form" data-newsletter-form novalidate>
            <label for="nb-email" class="sr-only">Email address</label>
            <input
              id="nb-email"
              name="email"
              type="email"
              required
              placeholder="Enter your email address"
              class="nb__input"
            />
            <button type="submit" class="nb__submit" aria-label="Subscribe">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <path d="M4 9h10m0 0L10 5m4 4l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </form>
          <p class="nb__note">No spam. Just useful updates.</p>
          <p class="nb__msg" role="status" data-newsletter-message></p>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .nb {
    padding: 4rem 0;
  }

  .nb__card {
    position: relative;
    border-radius: var(--radius-xl);
    padding: 3.5rem 3rem;
    overflow: hidden;
    background: var(--color-primary-900);
    color: white;
  }
  :global([data-theme='dark']) .nb__card {
    background: var(--color-primary-800);
  }

  .nb__glow {
    position: absolute;
    top: -50%;
    right: -20%;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,0.06), transparent 60%);
    pointer-events: none;
  }

  .nb__layout {
    position: relative;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: center;
  }
  @media (max-width: 768px) {
    .nb__layout { grid-template-columns: 1fr; gap: 2rem; }
    .nb__card { padding: 2.5rem 1.5rem; }
  }

  .nb__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-full);
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.15);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.8);
    margin-bottom: 1rem;
  }

  .nb__title {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: white;
    margin-bottom: 0.5rem;
  }

  .nb__sub {
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.65);
    line-height: 1.5;
  }

  /* Form */
  .nb__form {
    display: flex;
    gap: 0;
    background: white;
    border-radius: var(--radius-lg);
    padding: 0.3rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }

  .nb__input {
    flex: 1;
    height: 44px;
    padding: 0 1rem;
    border: none;
    background: transparent;
    font-size: var(--text-sm);
    color: var(--color-neutral-900);
    outline: none;
    border-radius: var(--radius-md);
    min-width: 0;
  }
  .nb__input::placeholder {
    color: var(--color-neutral-400);
  }

  .nb__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    border: none;
    background: var(--color-primary-600);
    color: white;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.2s, transform 0.2s var(--ease-out);
  }
  .nb__submit:hover {
    background: var(--color-primary-700);
    transform: scale(1.05);
  }

  .nb__note {
    font-size: 0.6875rem;
    color: rgba(255,255,255,0.45);
    margin-top: 0.6rem;
  }

  .nb__msg {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.8);
    margin-top: 0.35rem;
    min-height: 1rem;
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-newsletter-form]');
  const msg = document.querySelector<HTMLElement>('[data-newsletter-message]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = new FormData(form).get('email');
    if (msg) msg.textContent = `Thanks! Check ${email} to confirm.`;
    form.reset();
  });
</script>
