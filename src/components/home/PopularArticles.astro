---
import { Container, Text, Badge } from '@/components/ui';
import SectionHeading from './SectionHeading.astro';
import { formatDate } from '@/lib/content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts: allPosts } = Astro.props;
const popularPosts = allPosts
  .filter((p) => p.data.popular)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<section class="border-b border-(--color-border) bg-(--color-bg-subtle) py-16 lg:py-24">
  <Container size="lg">
    <SectionHeading kicker="Most read" heading="Readers keep coming back to these." />

    <ol
      class="mt-10 flex flex-col divide-y divide-(--color-border) border-y border-(--color-border)"
    >
      {
        popularPosts.map((post, i) => (
          <li>
            <a
              href={`/blog/${post.id}`}
              class="group flex items-center gap-6 py-6 hover:bg-(--color-surface)"
            >
              <span class="font-display w-10 shrink-0 text-3xl font-semibold text-(--color-text-muted)">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                  <Badge tone="neutral">{post.data.category}</Badge>
                  <Text size="xs" tone="muted" as="span">
                    {formatDate(post.data.pubDate)}
                  </Text>
                </div>
                <h3 class="font-display mt-1 truncate text-lg font-semibold text-(--color-text) group-hover:text-(--color-primary-700)">
                  {post.data.title}
                </h3>
              </div>
              <svg
                class="h-4 w-4 shrink-0 text-(--color-text-muted) transition-transform group-hover:translate-x-1"
                viewBox="0 0 12 12"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M2 6h8m0 0L6.5 2.5M10 6L6.5 9.5"
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </li>
        ))
      }
    </ol>
  </Container>
</section>
