---
/**
 * StoryMoment — editorial "why this site exists" section.
 * No testing claims. Focuses on being a clear, practical resource.
 * Theme-aware with ambient orbs using color-mix.
 */
import { Container } from '@/components/ui';
---

<section class="sm" data-reveal-group>
  <!-- Ambient glow -->
  <div class="sm__glow" aria-hidden="true">
    <div class="sm__orb sm__orb--1"></div>
    <div class="sm__orb sm__orb--2"></div>
  </div>

  <Container size="lg">
    <div class="sm__layout">
      <div class="sm__text" data-reveal>
        <h2 class="sm__heading font-display">
          Most "best AI tools" lists are written by people who never opened the app.
        </h2>
        <p class="sm__body">
          SmartWorkflowLab is different. We write practical, detailed guides about
          AI tools and workflow automation — the kind of content that actually helps
          you decide what to use, how to set it up, and whether it's worth paying for.
        </p>
        <p class="sm__body">
          No affiliate-driven rankings. No filler content to chase search traffic.
          Just clear, honest writing about tools that matter — from people who
          care about getting the details right.
        </p>
      </div>

      <div class="sm__signals" data-reveal>
        <div class="sm__signal fx-glass">
          <span class="sm__signal-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/>
            </svg>
          </span>
          <div>
            <span class="sm__signal-title">In-depth, not surface-level</span>
            <span class="sm__signal-desc">Every guide goes deep on setup, pricing, pros, cons, and alternatives.</span>
          </div>
        </div>
        <div class="sm__signal fx-glass">
          <span class="sm__signal-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/>
            </svg>
          </span>
          <div>
            <span class="sm__signal-title">Clear recommendations</span>
            <span class="sm__signal-desc">We tell you what we'd actually pick — and explain why.</span>
          </div>
        </div>
        <div class="sm__signal fx-glass">
          <span class="sm__signal-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </span>
          <div>
            <span class="sm__signal-title">No hidden sponsorships</span>
            <span class="sm__signal-desc">Nobody pays for placement or a favorable write-up.</span>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .sm {
    position: relative;
    padding: 6rem 0;
    border-top: 1px solid var(--color-border);
    overflow: hidden;
  }

  /* Ambient orbs */
  .sm__glow {
    position: absolute; inset: 0;
    pointer-events: none;
  }
  .sm__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
  }
  .sm__orb--1 {
    width: 500px; height: 500px;
    top: -150px; left: 10%;
    background: color-mix(in oklch, var(--color-primary-400) 10%, transparent);
  }
  .sm__orb--2 {
    width: 400px; height: 400px;
    bottom: -120px; right: 10%;
    background: color-mix(in oklch, var(--color-accent-400) 8%, transparent);
  }

  .sm__layout {
    position: relative;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: center;
  }

  @media (max-width: 768px) {
    .sm__layout { grid-template-columns: 1fr; gap: 3rem; }
  }

  .sm__heading {
    font-size: clamp(1.375rem, 2.8vw, 1.75rem);
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .sm__body {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    margin-bottom: 0.875rem;
    max-width: 520px;
  }
  .sm__body:last-child { margin-bottom: 0; }

  /* Signal cards */
  .sm__signals {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sm__signal {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .sm__signal:hover {
    border-color: color-mix(in oklch, var(--color-primary-400) 30%, var(--color-border));
    box-shadow: 0 0 24px color-mix(in oklch, var(--color-primary-400) 8%, transparent);
  }

  .sm__signal-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px; height: 38px;
    border-radius: var(--radius-md);
    background: color-mix(in oklch, var(--color-primary-400) 12%, var(--color-surface));
    color: var(--color-link);
  }
  .sm__signal-icon svg { width: 18px; height: 18px; }

  .sm__signal-title {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.2rem;
  }

  .sm__signal-desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
</style>
