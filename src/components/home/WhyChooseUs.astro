---
/**
 * WhyChooseUs — "Built for Curious Minds" section.
 * Left: kicker, title, description, 4 stats in a 2x2 grid
 * Right: 3 value proposition cards
 * Background: subtle color shift
 */
import { Container } from '@/components/ui';

interface Props {
  counts: {
    directory: number;
    articles: number;
    compare: number;
    prompts: number;
    workflows: number;
    glossary: number;
  };
}

const { counts } = Astro.props;

const stats = [
  { value: `${counts.directory}+`, label: 'AI Tools & Resources' },
  { value: `${counts.articles}+`, label: 'In-Depth Guides' },
  { value: `${counts.compare}+`, label: 'Comparisons' },
  { value: `${counts.prompts}+`, label: 'Ready-to-Use Prompts' },
];

const values = [
  {
    icon: '<path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/>',
    title: 'In-depth, not surface-level',
    desc: 'Every guide goes deep on setup, pricing, pros, cons, and alternatives.',
  },
  {
    icon: '<path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/>',
    title: 'Clear recommendations',
    desc: "We tell you what we'd actually pick — and explain why.",
  },
  {
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
    title: 'No hidden sponsorships',
    desc: 'Nobody pays for placement or a favorable write-up.',
  },
];
---

<section class="wcu">
  <Container size="lg">
    <div class="wcu__layout" data-reveal>
      <!-- LEFT -->
      <div class="wcu__left">
        <div class="wcu__kicker">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
          <span>WHY CHOOSE US</span>
        </div>
        <h2 class="wcu__title">Built for Curious Minds and Go-Getters</h2>
        <p class="wcu__sub">
          We carefully research and cover the best tools, so you don't have to.
          Get clear insights, honest guides, and practical resources — all in one place.
        </p>

        <div class="wcu__stats">
          {stats.map((s) => (
            <div class="wcu__stat">
              <span class="wcu__stat-value">{s.value}</span>
              <span class="wcu__stat-label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- RIGHT -->
      <div class="wcu__right">
        {values.map((v) => (
          <div class="wcu__value-card">
            <span class="wcu__value-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={v.icon} />
            </span>
            <div>
              <h3 class="wcu__value-title">{v.title}</h3>
              <p class="wcu__value-desc">{v.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>

<style>
  .wcu {
    padding: 5rem 0;
    background: var(--color-bg-subtle);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .wcu__layout {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: center;
  }
  @media (max-width: 860px) {
    .wcu__layout { grid-template-columns: 1fr; gap: 3rem; }
  }

  .wcu__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-primary-600);
    margin-bottom: 0.5rem;
  }
  :global([data-theme='dark']) .wcu__kicker { color: var(--color-primary-300); }

  .wcu__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-bottom: 0.75rem;
    max-width: 400px;
  }

  .wcu__sub {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    max-width: 420px;
    margin-bottom: 2.5rem;
  }

  /* Stats */
  .wcu__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 400px) { .wcu__stats { grid-template-columns: 1fr; } }

  .wcu__stat-value {
    display: block;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
    line-height: 1;
  }

  .wcu__stat-label {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  /* Value cards */
  .wcu__right {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .wcu__value-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s var(--ease-out);
  }
  .wcu__value-card:hover {
    border-color: color-mix(in oklch, var(--color-primary-400) 30%, var(--color-border));
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .wcu__value-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: color-mix(in oklch, var(--color-primary-100) 50%, var(--color-surface));
    color: var(--color-primary-500);
  }
  :global([data-theme='dark']) .wcu__value-icon {
    background: color-mix(in oklch, var(--color-primary-800) 30%, var(--color-surface));
    color: var(--color-primary-300);
  }
  .wcu__value-icon svg { width: 20px; height: 20px; }

  .wcu__value-title {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.2rem;
  }

  .wcu__value-desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
</style>
