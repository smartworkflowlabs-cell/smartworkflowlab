---
import { primaryNav } from '@/config/navigation';
import MegaMenu from '@/components/navigation/MegaMenu.astro';
import MobileMenu from '@/components/navigation/MobileMenu.astro';
import ThemeToggle from '@/components/navigation/ThemeToggle.astro';
import SearchModal from '@/components/navigation/SearchModal.astro';
import { Image } from 'astro:assets';
import logomark from '@/assets/brand/logomark.png';
import logomarkDark from '@/assets/brand/logomark-dark.png';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-20 border-b border-(--color-border) bg-(--color-bg)/90 backdrop-blur">
  <div
    class="mx-auto flex h-(--header-height) max-w-(--container-max) items-center justify-between gap-4 px-4 sm:px-6 lg:px-8"
  >
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="SmartWorkflowLab home">
      <Image
        src={logomark}
        alt=""
        width={34}
        height={34}
        class="h-8 w-8 dark:hidden"
        loading="eager"
      />
      <Image
        src={logomarkDark}
        alt=""
        width={34}
        height={34}
        class="hidden h-8 w-8 dark:block"
        loading="eager"
      />
      <span class="font-display text-lg font-semibold text-(--color-text)">
        Smart<span class="text-(--color-link)">Workflow</span>Lab
      </span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-6 sm:flex">
      {
        primaryNav.map((item) => {
          if (item.megaMenu) return <MegaMenu item={item} />;

          const isActive =
            item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'text-sm font-medium transition-colors hover:text-(--color-link)',
                isActive ? 'text-(--color-text)' : 'text-(--color-text-muted)',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2">
      <SearchModal />
      <div class="hidden sm:block">
        <ThemeToggle />
      </div>

      <button
        type="button"
        class="rounded-(--radius-md) p-2 text-(--color-text-muted) hover:bg-(--color-bg-subtle) sm:hidden"
        aria-label="Open menu"
        data-mobile-menu-open
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<MobileMenu />
