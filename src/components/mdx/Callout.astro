---
import { cn } from '@/lib/cn';

interface Props {
  tone?: 'info' | 'warning' | 'danger';
  title?: string;
}

const { tone = 'info', title } = Astro.props;

const tones: Record<NonNullable<Props['tone']>, string> = {
  info: 'border-(--color-primary-600)/40 bg-(--color-primary-500)/10',
  warning: 'border-(--color-warning-500)/40 bg-(--color-warning-500)/10',
  danger: 'border-(--color-danger-500)/40 bg-(--color-danger-500)/10',
};
---

<div class={cn('my-6 rounded-(--radius-lg) border-l-4 p-4', tones[tone])}>
  {title && <p class="mb-1 font-medium text-(--color-text)">{title}</p>}
  <div class="text-sm text-(--color-text-muted) [&>p]:m-0">
    <slot />
  </div>
</div>
