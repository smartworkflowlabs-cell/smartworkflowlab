---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { cn } from '@/lib/cn';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Responsive widths to generate — Astro derives the actual srcset from these. */
  widths?: number[];
  /** CSS `sizes` — "auto" (default) lets Astro compute it from the rendered layout. */
  sizes?: string;
  /** Set true for the single above-the-fold image on a page (e.g. the article hero). Disables lazy loading and blur-up, and hints the browser to fetch it first. */
  priority?: boolean;
  /** JPEG/WebP/AVIF quality, 0-100. Astro's Sharp service handles the actual compression. */
  quality?: number;
  class?: string;
}

const {
  src,
  alt,
  widths = [400, 800, 1200, 1600],
  sizes = 'auto',
  priority = false,
  quality = 75,
  class: className,
} = Astro.props;

// Blur-up placeholder: a tiny (24px-wide), heavily-compressed version of the
// same source, generated by Astro's image pipeline at build time. It's a
// real static asset (served from /_astro/ after build, same as any other
// optimized image), so we just point an <img> at it and blur it with CSS —
// no manual file reads or base64 encoding needed. Skipped for priority
// images, which load fast enough that a placeholder swap would just add
// visual noise.
const placeholder = priority
  ? null
  : await getImage({ src, width: 24, format: 'webp', quality: 20 });
---

<div
  class={cn('relative overflow-hidden bg-(--color-bg-subtle)', className)}
  style={`aspect-ratio: ${src.width} / ${src.height};`}
>
  {
    placeholder && (
      <img
        src={placeholder.src}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 h-full w-full scale-110 object-cover blur-xl"
      />
    )
  }
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat={src.format === 'svg' ? 'svg' : 'jpeg'}
    widths={widths}
    sizes={sizes}
    quality={quality}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    class={cn(
      'relative h-full w-full object-cover',
      !priority && 'opacity-0 transition-opacity duration-700',
    )}
    onload={!priority ? "this.classList.remove('opacity-0')" : undefined}
  />
</div>
