---
import { cn } from '@/lib/cn';

interface Props {
  /** HTML element to render as. Default 'div'. */
  as?: 'div' | 'section' | 'main' | 'article' | 'header' | 'footer';
  /** Max-width constraint. 'full' removes the constraint entirely. Default 'lg'. */
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full';
  class?: string;
}

const { as: Tag = 'div', size = 'lg', class: className, ...rest } = Astro.props;

const sizes: Record<NonNullable<Props['size']>, string> = {
  sm: 'max-w-2xl',
  md: 'max-w-4xl',
  lg: 'max-w-(--container-max)',
  xl: 'max-w-7xl',
  full: 'max-w-none',
};
---

<Tag class={cn('mx-auto w-full px-4 sm:px-6 lg:px-8', sizes[size], className)} {...rest}>
  <slot />
</Tag>
