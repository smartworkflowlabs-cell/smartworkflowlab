---
import { cn } from '@/lib/cn';

interface Option {
  label: string;
  value: string;
  disabled?: boolean;
}

interface Props {
  name: string;
  id?: string;
  label: string;
  hideLabel?: boolean;
  options: Option[];
  value?: string;
  placeholder?: string;
  required?: boolean;
  disabled?: boolean;
  helpText?: string;
  error?: string;
  class?: string;
}

const {
  name,
  id = name,
  label,
  hideLabel = false,
  options,
  value,
  placeholder,
  required = false,
  disabled = false,
  helpText,
  error,
  class: className,
  ...rest
} = Astro.props;

const describedBy = error ? `${id}-error` : helpText ? `${id}-help` : undefined;
---

<div class="flex flex-col gap-1.5">
  <label for={id} class={cn('text-sm font-medium text-(--color-text)', hideLabel && 'sr-only')}>
    {label}
    {
      required && (
        <span class="text-(--color-danger-text)" aria-hidden="true">
          {' '}
          *
        </span>
      )
    }
  </label>

  <select
    id={id}
    name={name}
    required={required}
    disabled={disabled}
    aria-invalid={error ? 'true' : undefined}
    aria-describedby={describedBy}
    class={cn(
      'h-10 rounded-(--radius-md) border bg-(--color-surface) px-3 text-sm text-(--color-text)',
      'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-focus-ring)',
      'disabled:cursor-not-allowed disabled:opacity-50',
      error ? 'border-(--color-danger)' : 'border-(--color-border-strong)',
      className,
    )}
    {...rest}
  >
    {
      placeholder && (
        <option value="" disabled selected={!value}>
          {placeholder}
        </option>
      )
    }
    {
      options.map((opt) => (
        <option value={opt.value} selected={opt.value === value} disabled={opt.disabled}>
          {opt.label}
        </option>
      ))
    }
  </select>

  {
    error ? (
      <p id={`${id}-error`} class="text-sm text-(--color-danger-text)" role="alert">
        {error}
      </p>
    ) : (
      helpText && (
        <p id={`${id}-help`} class="text-sm text-(--color-text-muted)">
          {helpText}
        </p>
      )
    )
  }
</div>
