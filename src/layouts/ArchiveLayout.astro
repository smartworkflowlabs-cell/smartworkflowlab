---
import BaseLayout from './BaseLayout.astro';
import { Container, Heading, Text } from '@/components/ui';
import PostCard from '@/components/blog/PostCard.astro';
import Pagination from '@/components/blog/Pagination.astro';
import Breadcrumb, { type Crumb } from '@/components/navigation/Breadcrumb.astro';
import { monthName } from '@/lib/content';
import type { CollectionEntry } from 'astro:content';
import type { Page } from 'astro';

interface Props {
  title: string;
  description: string;
  breadcrumbItems: Crumb[];
  basePath: string;
  /** Present when listing posts directly (year or year/month view). Omit for the top-level index, which shows years instead. */
  page?: Page<CollectionEntry<'blog'>>;
  /** Present only on the top-level index — every year with a post, newest first. */
  years?: { year: number; count: number }[];
  /** Present only on a year view — every month within that year with a post, newest first. */
  months?: { month: number; count: number }[];
  /** The year this page is scoped to, for building month links. */
  year?: number;
}

const { title, description, breadcrumbItems, basePath, page, years, months, year } = Astro.props;
const posts = page?.data ?? [];
---

<BaseLayout title={title} description={description}>
  <Container size="lg" class="py-16">
    <Breadcrumb class="mb-6" items={breadcrumbItems} />

    <Heading as="h1">{title}</Heading>
    <Text tone="muted" size="lg" class="mt-3 max-w-prose">{description}</Text>

    {
      years && (
        <div class="mt-10 flex flex-col gap-3">
          {years.map(({ year: y, count }) => (
            <a
              href={`/blog/archive/${y}`}
              class="flex items-center justify-between rounded-(--radius-lg) border border-(--color-border) p-4 hover:bg-(--color-bg-subtle)"
            >
              <Heading as="h2" size="sm" class="!mb-0">
                {y}
              </Heading>
              <Text tone="muted" size="sm">
                {count} {count === 1 ? 'post' : 'posts'}
              </Text>
            </a>
          ))}
        </div>
      )
    }

    {
      months && year && (
        <div class="mt-10 flex flex-col gap-3">
          {months.map(({ month, count }) => (
            <a
              href={`/blog/archive/${year}/${month}`}
              class="flex items-center justify-between rounded-(--radius-lg) border border-(--color-border) p-4 hover:bg-(--color-bg-subtle)"
            >
              <Heading as="h2" size="sm" class="!mb-0">
                {monthName(month)}
              </Heading>
              <Text tone="muted" size="sm">
                {count} {count === 1 ? 'post' : 'posts'}
              </Text>
            </a>
          ))}
        </div>
      )
    }

    {
      page && (
        <>
          {posts.length > 0 ? (
            <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {posts.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          ) : (
            <p class="mt-10 text-(--color-text-muted)">No posts in this period.</p>
          )}

          <Pagination page={page} basePath={basePath} />
        </>
      )
    }
  </Container>
</BaseLayout>
