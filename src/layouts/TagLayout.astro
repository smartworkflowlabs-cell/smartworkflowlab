---
import BaseLayout from './BaseLayout.astro';
import { Container, Heading, Text, Badge } from '@/components/ui';
import PostCard from '@/components/blog/PostCard.astro';
import Pagination from '@/components/blog/Pagination.astro';
import Breadcrumb from '@/components/navigation/Breadcrumb.astro';
import { slugify } from '@/lib/content';
import type { CollectionEntry } from 'astro:content';
import type { Page } from 'astro';

interface Props {
  /** Display name, e.g. "astro". */
  tag: string;
  page: Page<CollectionEntry<'blog'>>;
  /** Every tag in the site, for the filter row. Pass [] to hide it. */
  allTags?: string[];
}

const { tag, page, allTags = [] } = Astro.props;
const posts = page.data;
const basePath = `/blog/tag/${slugify(tag)}`;
---

<BaseLayout title={`#${tag} — Blog`} description={`Posts tagged “${tag}”.`}>
  <Container size="lg" class="py-16">
    <Breadcrumb class="mb-6" items={[{ label: 'Blog', href: '/blog' }, { label: `#${tag}` }]} />

    <Heading as="h1">#{tag}</Heading>
    <Text tone="muted" size="lg" class="mt-3">
      {page.total}
      {page.total === 1 ? 'post' : 'posts'} tagged “{tag}”.
    </Text>

    {
      allTags.length > 1 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {allTags.map((t) =>
            t === tag ? (
              <Badge tone="primary">#{t}</Badge>
            ) : (
              <a href={`/blog/tag/${slugify(t)}`}>
                <Badge tone="neutral">#{t}</Badge>
              </a>
            ),
          )}
        </div>
      )
    }

    {
      posts.length > 0 ? (
        <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="mt-10 text-(--color-text-muted)">No posts with this tag yet.</p>
      )
    }

    <Pagination page={page} basePath={basePath} />
  </Container>
</BaseLayout>
