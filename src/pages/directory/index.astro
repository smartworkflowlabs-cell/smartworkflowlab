---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Container, Text, Badge } from '@/components/ui';
import Breadcrumb from '@/components/navigation/Breadcrumb.astro';
import { Image } from 'astro:assets';
import { breadcrumbSchema } from '@/lib/seo';

const title = 'AI Tools Directory — Reviews, Pricing & Alternatives';
const description =
  'Browse our directory of AI tools — honest overviews, pricing, pros and cons, and alternatives for ChatGPT, Claude, Gemini, and more. Find the right tool fast.';

const tools = (await getCollection('directory', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);

// Unique categories for the filter bar.
const categories = [...new Set(tools.map((t) => t.data.category))].sort();

const structuredData = [breadcrumbSchema([{ label: 'Directory', href: '/directory' }])];
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <Container size="lg" class="py-12 lg:py-16">
    <Breadcrumb class="mb-6" items={[{ label: 'Directory' }]} />

    <div class="max-w-2xl">
      <p class="font-mono text-xs font-medium tracking-[0.15em] text-(--color-link) uppercase">
        AI Tools Directory
      </p>
      <h1 class="font-display mt-3 text-3xl font-semibold text-(--color-text) sm:text-4xl">
        Every AI tool, honestly reviewed.
      </h1>
      <Text size="lg" tone="muted" class="mt-4">
        Overviews, pricing, pros and cons, and alternatives — so you can find the right AI tool
        without wading through marketing pages.
      </Text>
    </div>

    <!-- Filter bar (progressive enhancement; no-JS shows all) -->
    {
      categories.length > 1 && (
        <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter by category">
          <button
            class="dir-filter is-active rounded-(--radius-md) border border-(--color-border) px-3 py-1.5 text-sm font-medium text-(--color-text)"
            data-category="all"
          >
            All
          </button>
          {categories.map((cat) => (
            <button
              class="dir-filter rounded-(--radius-md) border border-(--color-border) px-3 py-1.5 text-sm font-medium text-(--color-text-muted)"
              data-category={cat}
            >
              {cat}
            </button>
          ))}
        </div>
      )
    }

    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" id="dir-grid">
      {
        tools.map((tool) => (
          <a
            href={`/directory/${tool.id}`}
            class="dir-card group flex flex-col rounded-(--radius-xl) border border-(--color-border) bg-(--color-surface) p-5 transition-shadow hover:shadow-(--shadow-md)"
            data-category={tool.data.category}
          >
            <div class="flex items-center gap-3">
              {tool.data.logo && (
                <Image
                  src={tool.data.logo}
                  alt={`${tool.data.name} logo`}
                  width={40}
                  height={40}
                  class="h-10 w-10 shrink-0 rounded-(--radius-sm) object-contain"
                />
              )}
              <div class="min-w-0">
                <h2 class="font-display font-semibold text-(--color-text) group-hover:text-(--color-primary-700)">
                  {tool.data.name}
                </h2>
                <Text size="xs" tone="muted">
                  {tool.data.category}
                </Text>
              </div>
            </div>
            <Text size="sm" tone="muted" class="mt-3 flex-1">
              {tool.data.tagline}
            </Text>
            {tool.data.freeTier && (
              <div class="mt-3">
                <Badge tone="success">Free tier</Badge>
              </div>
            )}
          </a>
        ))
      }
    </div>

    {tools.length === 0 && <p class="mt-10 text-(--color-text-muted)">Tools coming soon.</p>}
  </Container>

  <style>
    .dir-filter.is-active {
      background: var(--color-primary-900);
      color: white;
      border-color: var(--color-primary-900);
    }
  </style>

  <script>
    function initDirectoryFilter() {
      const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.dir-filter'));
      const cards = Array.from(document.querySelectorAll<HTMLElement>('.dir-card'));
      if (buttons.length === 0) return;

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const cat = btn.dataset.category;
          buttons.forEach((b) => b.classList.toggle('is-active', b === btn));
          cards.forEach((card) => {
            const show = cat === 'all' || card.dataset.category === cat;
            card.style.display = show ? '' : 'none';
          });
        });
      });
    }
    initDirectoryFilter();
  </script>
</BaseLayout>
