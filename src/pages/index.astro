---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import FeaturedCategories from '@/components/home/FeaturedCategories.astro';
import PopularArticles from '@/components/home/PopularArticles.astro';
import LatestArticles from '@/components/home/LatestArticles.astro';
import Newsletter from '@/components/home/Newsletter.astro';
import CTASection from '@/components/home/CTASection.astro';
import FAQSection from '@/components/home/FAQSection.astro';
import { SITE_NAME, SITE_DESCRIPTION } from '@/config/site';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const latestPost = [...posts].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)[0];
---

<BaseLayout title={SITE_NAME} description={SITE_DESCRIPTION} includeSiteSchema>
  {latestPost && <Hero latestPost={latestPost} />}
  <FeaturedCategories posts={posts} />
  <PopularArticles posts={posts} />
  <LatestArticles posts={posts} />
  <FAQSection />
  <Newsletter />
  <CTASection />
</BaseLayout>
