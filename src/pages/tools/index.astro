---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Container, Card, Text } from '@/components/ui';
import Breadcrumb from '@/components/navigation/Breadcrumb.astro';

const title = 'Free AI & Automation Tools';
const description =
  'Free calculators and finders for AI and automation — estimate API costs, work out automation ROI, and find the right tool for your task. No sign-up required.';

const tools = [
  {
    href: '/tools/automation-roi-calculator',
    name: 'Automation ROI Calculator',
    blurb:
      'See what a repetitive task costs you now, and what automating it saves — in hours and money per year.',
    tag: 'Calculator',
    icon: 'M3 3v18h18M7 15l3-3 3 3 5-6',
  },
  {
    href: '/tools/ai-cost-calculator',
    name: 'AI API Cost Calculator',
    blurb:
      'Estimate what GPT, Claude, and Gemini cost for your workload, compared side by side per request and per month.',
    tag: 'Calculator',
    icon: 'M9 7h6m-6 4h6m-6 4h4M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z',
  },
  {
    href: '/tools/ai-tool-finder',
    name: 'AI Tool Finder',
    blurb:
      'Answer three quick questions and get matched to the right guide and approach for your situation.',
    tag: 'Finder',
    icon: 'M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z',
  },
];
---

<BaseLayout title={title} description={description}>
  <Container size="lg" class="py-12 lg:py-16">
    <Breadcrumb class="mb-6" items={[{ label: 'Tools' }]} />

    <div class="max-w-2xl">
      <h1 class="font-display text-3xl font-semibold text-(--color-text) sm:text-4xl">
        Free tools
      </h1>
      <p class="mt-4 text-lg text-(--color-text-muted)">
        Quick, no-sign-up calculators and finders to help you make AI and automation decisions with
        real numbers instead of guesswork.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        tools.map((tool) => (
          <a href={tool.href} class="group block">
            <Card interactive class="flex h-full flex-col">
              <div class="flex items-center justify-between">
                <span class="flex h-10 w-10 items-center justify-center rounded-(--radius-md) bg-(--color-primary-50) text-(--color-link)">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path
                      d={tool.icon}
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                <span class="font-mono text-[11px] tracking-[0.1em] text-(--color-text-muted) uppercase">
                  {tool.tag}
                </span>
              </div>
              <h2 class="font-display mt-4 text-lg font-semibold text-(--color-text) group-hover:text-(--color-primary-700)">
                {tool.name}
              </h2>
              <Text size="sm" tone="muted" class="mt-2 flex-1">
                {tool.blurb}
              </Text>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-(--color-link)">
                Open tool
                <svg
                  class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1"
                  viewBox="0 0 12 12"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M2 6h8m0 0L6.5 2.5M10 6L6.5 9.5"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </Card>
          </a>
        ))
      }
    </div>
  </Container>
</BaseLayout>
